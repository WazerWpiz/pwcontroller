<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCursorPad"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/viewCursorPad"
        android:layout_width="@dimen/touchpad_width"
        android:layout_height="@dimen/touchpad_height"
        android:background="@drawable/cursor_pad_bg"
        android:gravity="center"
        android:text="@string/cursor_pad_label"
        android:textColor="#AAFFFFFF"
        android:textSize="11sp" />
</LinearLayout>
